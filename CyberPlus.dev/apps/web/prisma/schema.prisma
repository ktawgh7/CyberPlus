// CyberPlus Prisma Schema
// Compatible with SQLite for zero-setup local dev, and Postgres in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OFFICER
  ADMIN
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum KeyStatus {
  NOT_ENROLLED
  PENDING_ACTIVATION
  ACTIVE
  FROZEN
  REVOKED
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  EMERGENCY_FREEZE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RecoveryStatus {
  PENDING_FIRST_APPROVAL
  PENDING_SECOND_APPROVAL
  ACTIVATION_DELAY
  COMPLETED
  CANCELLED
}

enum ApiKeyMode {
  SANDBOX
  LIVE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id             String      @id @default(uuid())
  name           String
  email          String      @unique
  passwordHash   String
  emailVerified  Boolean     @default(false)
  role           Role        @default(USER)
  accountType    AccountType @default(INDIVIDUAL)
  lockedUntil    DateTime?
  failedAttempts Int         @default(0)
  duressCodeHash String?
  duressActive   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  sessions           Session[]
  passkeys           Passkey[]
  emailTokens        EmailToken[]
  resetTokens        ResetToken[]
  profile            Profile?
  documentSubmissions DocumentSubmission[]
  appointments       Appointment[]
  connectedApps      ConnectedApp[]
  recoveryRequests   RecoveryRequest[]
  recoveryApprovals  RecoveryApproval[]   @relation("OfficerApprovals")
  duressFlags        DuressFlag[]
  auditLogs          AuditLog[]
  memberships        Membership[]
  tickets            Ticket[]
  ticketReplies      TicketReply[]
  contactMessages    ContactMessage[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Passkey {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String?  // JSON array
  prfSupported Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
}

model EmailToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Profile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             Int          @default(1)
  status           KeyStatus    @default(NOT_ENROLLED)
  lastVerifiedAt   DateTime?
  emergencyKeySalt String?      // Encrypted device-side salt backup if provided
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  identityKeys     IdentityKey[]
}

model IdentityKey {
  id           String      @id @default(uuid())
  profileId    String
  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  commitment   String      @unique // Semaphore identity commitment (decimal/hex string)
  tier         Int         @default(1)
  status       KeyStatus   @default(PENDING_ACTIVATION)
  isSoftware   Boolean     @default(false) // True if derived via PIN fallback without PRF
  activatesAt  DateTime    @default(now()) // 48-hour delay for recovery / rotations
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  events       KeyEvent[]
  attacks      AttackAttempt[]
}

model KeyEvent {
  id          String      @id @default(uuid())
  keyId       String
  key         IdentityKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  eventType   String      // CREATED, ROTATED, FROZEN, UNFROZEN, REVOKED
  detail      String?
  timestamp   DateTime    @default(now())
}

model GroupLeaf {
  id          String   @id @default(uuid())
  groupName   String   // verified-humans-tier1, verified-humans-tier2, verified-humans-tier3
  commitment  String
  leafIndex   Int
  createdAt   DateTime @default(now())

  @@unique([groupName, commitment])
  @@unique([groupName, leafIndex])
}

model GroupRoot {
  id          String   @id @default(uuid())
  groupName   String
  root        String   // Merkle root string
  depth       Int      @default(20)
  size        Int      @default(0)
  timestamp   DateTime @default(now())

  @@index([groupName, timestamp])
}

model DocumentSubmission {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType        String         // PASSPORT, DRIVERS_LICENSE, NATIONAL_ID
  docNumber      String
  fullName       String
  country        String
  status         DocumentStatus @default(PENDING)
  reviewNotes    String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
}

model Location {
  id          String   @id @default(uuid())
  name        String
  address     String
  city        String
  country     String
  postalCode  String
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  appointments Appointment[]
}

model Appointment {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dateTime    DateTime
  tier        Int               @default(2) // Target tier (2 or 3)
  status      AppointmentStatus @default(CONFIRMED)
  notes       String?
  completedBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ConnectedApp {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId          String   // Scope identifier
  appName        String
  pseudonymousId String   // Nullifier for this app
  connectedAt    DateTime @default(now())

  @@unique([userId, appId])
}

model Nullifier {
  id            String   @id @default(uuid())
  nullifierHash String   @unique
  appScope      String
  tier          Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([appScope])
}

model Challenge {
  id           String    @id @default(uuid())
  apiKeyId     String?
  apiKey       ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  appScope     String
  message      String
  requiredTier Int       @default(1)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  verifications VerificationEvent[]
}

model VerificationEvent {
  id            String    @id @default(uuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  verified      Boolean
  tier          Int?
  nullifierHash String?
  reason        String?
  signedToken   String?
  timestamp     DateTime  @default(now())
}

model AttackAttempt {
  id          String       @id @default(uuid())
  keyId       String?
  key         IdentityKey? @relation(fields: [keyId], references: [id], onDelete: SetNull)
  appId       String
  region      String       // Coarse IP-derived region e.g. "US-East", "EU-Central"
  userAgent   String
  attemptType String       // FROZEN_KEY_USE, REVOKED_KEY_USE, RATE_LIMIT_EXCEEDED
  timestamp   DateTime     @default(now())
}

model RecoveryRequest {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        RecoveryStatus  @default(PENDING_FIRST_APPROVAL)
  duressTriggered Boolean       @default(false)
  newCommitment String?         // Prepared new Semaphore identity commitment
  activatesAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  approvals     RecoveryApproval[]
}

model RecoveryApproval {
  id          String          @id @default(uuid())
  requestId   String
  request     RecoveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  officerId   String
  officer     User            @relation("OfficerApprovals", fields: [officerId], references: [id], onDelete: Cascade)
  step        Int             // 1 = First officer, 2 = Second officer
  notes       String?
  approvedAt  DateTime        @default(now())

  @@unique([requestId, officerId])
}

model DuressFlag {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // LOGIN, RECOVERY, KEY_ROTATE
  ipAddress   String?
  context     String?
  reviewed    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    String   // JSON stringified metadata
  prevHash  String   // SHA-256 of the previous entry
  hash      String   // SHA-256(content + prevHash)
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model Organization {
  id               String       @id @default(uuid())
  name             String
  slug             String       @unique
  stripeCustomerId String?
  plan             String       @default("PILOT_BUSINESS")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  memberships      Membership[]
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  usageRecords     UsageRecord[]
  subscriptions    Subscription[]
}

model Membership {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgRole      @default(MEMBER)
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
}

model ApiKey {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  prefix      String       // e.g. "cp_live_" or "cp_test_"
  keyHash     String       @unique // SHA-256 hash of the full API key
  mode        ApiKeyMode   @default(SANDBOX)
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  challenges  Challenge[]
}

model Webhook {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url         String
  secret      String       // Encrypted HMAC secret
  events      String       // Comma-separated event types e.g. "verification.succeeded,key.frozen"
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       String
  payload     String
  statusCode  Int?
  response    String?
  attempts    Int      @default(1)
  success     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UsageRecord {
  id                 String       @id @default(uuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  date               String       // YYYY-MM-DD
  verificationsCount Int          @default(0)
  sandboxCount       Int          @default(0)

  @@unique([orgId, date])
}

model Subscription {
  id                 String       @id @default(uuid())
  orgId              String       @unique
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stripeSubId        String?      @unique
  status             String       @default("active")
  plan               String       @default("BUSINESS_MONTHLY")
  currentPeriodEnd   DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Ticket {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    TicketStatus  @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String
  category    String
  readTime    String
  publishedAt DateTime @default(now())
}

